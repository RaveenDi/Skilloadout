{
  "name": "skillloadout",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Loadout \u2014 a curated, auto-updating library of the best AI agent skills (Claude, Codex/ChatGPT, Gemini, Copilot, Cursor), distributed as a Claude Code plugin marketplace and an MCP server, straight off this repo.",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "discover": "node scripts/discover.mjs",
    "update": "node scripts/discover.mjs && node scripts/sync.mjs",
    "validate": "node scripts/validate.mjs",
    "picks": "node scripts/resolve-picks.mjs",
    "candidates": "node scripts/curation-candidates.mjs",
    "marketplace": "node scripts/build-marketplace.mjs",
    "verify-safety": "node scripts/verify-safety.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  }
}
